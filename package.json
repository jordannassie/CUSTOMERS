{
  "name": "customers-app",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "predev": "bash scripts/scan-payload.sh",
    "dev": "next dev",
    "prebuild": "bash scripts/scan-payload.sh",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "check:auth": "node scripts/check-auth-calls.ts",
    "check:routes": "node scripts/check-routes.ts",
    "task:ready": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON scripts/task-ready.ts",
    "db:types": "supabase gen types typescript --linked > src/types/database.types.ts",
    "prepare": "husky",
    "scan": "bash scripts/scan-payload.sh && bash scripts/scan-secrets.sh --rev HEAD",
    "test": "bash scripts/test-db-reset.sh && vitest run --project unit",
    "test:e2e": "playwright test",
    "evals": "vitest run --project evals"
  },
  "dependencies": {
    "@supabase/ssr": "^0.12.4",
    "@supabase/supabase-js": "^2.109.0",
    "@t3-oss/env-nextjs": "^0.13.11",
    "lucide-react": "^1.31.0",
    "next": "16.3.0",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "react-markdown": "^10.1.0",
    "recharts": "^2.15.4",
    "remark-gfm": "^4.0.1",
    "server-only": "^0.0.1",
    "stripe": "^22.5.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@netlify/plugin-nextjs": "^5.15.13",
    "@playwright/test": "^1.63.0",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "autoevals": "^0.0.132",
    "eslint": "^9",
    "eslint-config-next": "16.3.0",
    "eslint-plugin-boundaries": "^7.2.0",
    "husky": "^9.1.7",
    "tailwindcss": "^4",
    "typescript": "^5",
    "vitest": "^4.1.11",
    "vitest-evals": "^0.17.0"
  }
}
