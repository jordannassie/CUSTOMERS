# ─── Supabase ────────────────────────────────────────────────────────────────
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# ─── Admin panel ─────────────────────────────────────────────────────────────
ADMIN_PIN=1234
ADMIN_SESSION_SECRET=generate-a-strong-32+-character-random-string-here

# ─── Google Places (server-side only — never prefix with NEXT_PUBLIC_) ───────
GOOGLE_PLACES_API_KEY=your-google-places-api-key

# ─── AI Providers ────────────────────────────────────────────────────────────
# At least one provider key is required for real visibility scans.
# The adapter degrades gracefully to "not configured" when keys are absent —
# it never fabricates scan results.
OPENAI_API_KEY=your-openai-api-key
ANTHROPIC_API_KEY=your-anthropic-api-key
PERPLEXITY_API_KEY=your-perplexity-api-key

# ─── Cron ────────────────────────────────────────────────────────────────────
# Required in the x-cron-secret header for the scheduled monitoring endpoint.
# Generate a random 32+ character string.
GEO_CRON_SECRET=generate-a-strong-32+-character-random-string-here

# ─── Stripe (self-serve billing) ─────────────────────────────────────────────
# Required to enable self-serve subscription checkout and billing portal.
#
# SETUP STEPS:
# 1. Create a Stripe account at https://stripe.com
# 2. Create ONE Product per plan in Stripe Dashboard → Products:
#      Starter   — $149/month/business  (recurring monthly)
#      Growth    — $297/month/business  (recurring monthly)
#      Pro       — $497/month/business  (recurring monthly)
# 3. Copy each Price ID (price_...) and set below.
# 4. Add webhook endpoint in Stripe Dashboard → Developers → Webhooks:
#      URL: https://customers.direct/api/stripe/webhook
#      Events to enable:
#        checkout.session.completed
#        customer.subscription.created
#        customer.subscription.updated
#        customer.subscription.deleted
#        customer.updated
#        invoice.created
#        invoice.finalized
#        invoice.paid
#        invoice.payment_failed
#        invoice.payment_action_required
# 5. Copy the Signing Secret (whsec_...) to STRIPE_WEBHOOK_SECRET below.
#
STRIPE_SECRET_KEY=sk_live_...                    # or sk_test_... for development
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_live_...   # or pk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...

# Stripe Price IDs — ONE per plan, monthly recurring
# (Replace with actual Price IDs from Stripe Dashboard)
STRIPE_PRICE_STARTER_MONTHLY=price_...           # $149/mo — Starter plan
STRIPE_PRICE_GROWTH_MONTHLY=price_...            # $297/mo — Growth plan
STRIPE_PRICE_PRO_MONTHLY=price_...               # $497/mo — Pro plan

# Billing feature flags
# Set BILLING_ENABLED=true to activate Stripe checkout (do NOT enable until Stripe prices are created)
# Set BETA_FREE_ACCESS=false to disable beta free access (only after billing is fully configured)
BILLING_ENABLED=false
BETA_FREE_ACCESS=true

# Optional: Override the base URL used in Stripe redirect URLs.
# Defaults to the incoming request origin if not set.
# NEXT_PUBLIC_APP_URL=https://customers.direct

# ─── DataForSEO (SEO intelligence) ───────────────────────────────────────────
# Required for the SEO Intelligence dashboard (keyword rankings, competitor
# gaps, backlink analysis). Without these, the SEO page shows a "not
# configured" state instead of failing.
#
# Sign up at https://dataforseo.com (pay-per-use, ~$0.05–0.25 per full scan)
# SEO data is cached for 7 days per business to minimize API costs.
#
DATAFORSEO_USERNAME=your-dataforseo-login-email
DATAFORSEO_PASSWORD=your-dataforseo-api-password
