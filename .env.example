# Every variable here is declared in src/lib/env.ts. Required ones fail the build when missing.
# Copy to .env.local for local development. Never commit real values.

# Supabase (required)
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Site URLs (optional). SITE_URL is used for auth redirects; APP_URL overrides Stripe redirect URLs.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_APP_URL=

# AI providers (optional). Scans report "not configured" for a missing key; they never fake results.
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
PERPLEXITY_API_KEY=
OPENAI_NEWS_MODEL=gpt-4o

# Business data (optional)
GOOGLE_PLACES_API_KEY=
FIRECRAWL_API_KEY=
BROWSERLESS_API_KEY=

# Search Intelligence (optional, on hold until D-06 is decided)
DATAFORSEO_USERNAME=
DATAFORSEO_PASSWORD=

# Stripe (optional). Use sandbox keys (sk_test_...) outside production.
# Webhook URL: https://customers.direct/api/stripe/webhook
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_STARTER_MONTHLY=
STRIPE_PRICE_GROWTH_MONTHLY=
STRIPE_PRICE_PRO_MONTHLY=

# Email (optional)
RESEND_API_KEY=
EMAIL_FROM=

# Scheduled jobs (optional). Long random strings sent by the scheduler.
GEO_CRON_SECRET=
WORKER_SECRET=

# Admin access (optional). Comma-separated lists.
ADMIN_EMAILS=you@example.com
ADMIN_USER_IDS=

# Feature flags: "true" or "false"
BILLING_ENABLED=false
BETA_FREE_ACCESS=true
TRIAL_ENABLED=false
