# Supabase
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Admin panel
ADMIN_PIN=1234
ADMIN_SESSION_SECRET=generate-a-strong-32+-character-random-string-here

# Server-side Google Places search (never prefix with NEXT_PUBLIC_)
GOOGLE_PLACES_API_KEY=your-google-places-api-key

# --- Customers.Direct AI Search Visibility (GEO) platform -------------------

# At least one AI provider key is required for real visibility runs.
# The provider adapter (src/lib/geo/providers) degrades gracefully to a
# clearly-labeled "not configured" state when none are set — it never
# fabricates results.
OPENAI_API_KEY=your-openai-api-key
ANTHROPIC_API_KEY=your-anthropic-api-key
PERPLEXITY_API_KEY=your-perplexity-api-key

# Shared secret required in the `x-cron-secret` header for the scheduled
# monitoring endpoint (/api/geo/cron/run-monitoring). Generate a random
# 32+ character string.
GEO_CRON_SECRET=generate-a-strong-32+-character-random-string-here
