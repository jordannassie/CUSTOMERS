# Every variable here is declared in src/lib/env.ts. Required ones fail the build when missing.
# Copy to .env.local for local development. Never commit real values.

# Supabase (required)
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Site URLs: the address in login, email and Stripe links (APP_URL first, then SITE_URL). Required in production:
# a production build or server without one fails. On Netlify both default to the site's address (the primary domain
# on the live site, the deploy's address on previews), and a live build without an https address fails.
# In development an empty APP_URL means links use the dev server's own address, whatever its port.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_APP_URL=

# Public AI Business Launch Kit page only. Paste a Stripe Payment Link or Bundle URL.
# Used by /start-ai-business Buy Now buttons. Does not change existing Stripe billing.
NEXT_PUBLIC_LAUNCH_KIT_PAYMENT_LINK=

# Optional overrides for the official Beehiiv subscribe form.
# Blank uses the embedded form already published on the site.
NEXT_PUBLIC_BEEHIIV_EMBED_SRC=
NEXT_PUBLIC_BEEHIIV_FORM_ID=

# AI providers (optional). Scans report "not configured" for a missing key; they never fake results.
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
# Background AI jobs fall back to OpenAI when Claude fails (uses OPENAI_API_KEY). "false" turns it off.
AI_FALLBACK_ENABLED=true
AI_FALLBACK_MODEL_FAST=gpt-4.1-mini
AI_FALLBACK_MODEL_SMART=gpt-4.1
PERPLEXITY_API_KEY=
OPENAI_NEWS_MODEL=gpt-4o

# Business data (optional)
GOOGLE_PLACES_API_KEY=
# true in dev or Playwright: competitor suggestions come from fixtures, no Google calls
PLACES_FIXTURES=
# true in dev or Playwright: auto-fill and question picking come from fixtures, no Firecrawl, Google or Claude calls
ONBOARDING_FIXTURES=
FIRECRAWL_API_KEY=

# Stripe (optional). Use sandbox keys (sk_test_...) outside production.
# Webhook URL: https://customers.direct/api/stripe/webhook
# One-time AI video ads at /ads use this same secret key and webhook. No separate price id.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
# Dev and Playwright only: fake card step, no Stripe calls.
STRIPE_CHECKOUT_FIXTURES=
STRIPE_PRICE_STARTER_MONTHLY=
STRIPE_PRICE_GROWTH_MONTHLY=
STRIPE_PRICE_PRO_MONTHLY=

# Email (optional)
RESEND_API_KEY=
# For example: Customers.Direct <hello@mail.customers.direct> (the domain verified in Resend, src/modules/email/README.md)
EMAIL_FROM=
# At least 32 random characters, e.g. openssl rand -base64 48. Signs unsubscribe links.
EMAIL_UNSUBSCRIBE_SECRET=

# Scan worker (optional). A long random string; pg_net sends it from Supabase Vault (supabase/migrations/README.md).
WORKER_SECRET=
# Seconds the scan worker keeps claiming jobs: 600 on Netlify (default), 240 on Vercel.
WORKER_TIME_BUDGET_SECONDS=
# Where Run scan starts the worker at once, e.g. https://<site>/.netlify/functions/scan-worker-background.
# Unset: the job waits for the every-minute schedule.
WORKER_URL=
# Local dev only: set to true to run the worker inside the dev server when WORKER_URL is unset.
WORKER_IN_PROCESS=

# Admin access (optional). Comma-separated emails; the only source of admin access.
ADMIN_EMAILS=you@example.com
# Alert the admins when real AI cost for the day (UTC) passes this many US dollars. Unset: no cost alert.
ALERT_DAILY_COST_USD=50

# Days a deleted account or business is kept (restorable by an admin) before its data is removed for good.
# Unset: 30. The legal deadline is not confirmed yet (D-77).
DELETION_WAIT_DAYS=

# Feature flags: "true" or "false"
# Show where AI listed the business ("named 2nd") on the Overview. Off until decided (D-63).
SHOW_POSITION=false
# Rewrite the report fixes with AI, checked against their numbers (reports/v2/wording). Off: template wording.
REPORT_AI_WORDING=false
