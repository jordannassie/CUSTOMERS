# ─── Supabase ────────────────────────────────────────────────────────────────
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# ─── Admin panel ─────────────────────────────────────────────────────────────
ADMIN_PIN=1234
ADMIN_SESSION_SECRET=generate-a-strong-32+-character-random-string-here

# ─── Google Places (server-side only — never prefix with NEXT_PUBLIC_) ───────
GOOGLE_PLACES_API_KEY=your-google-places-api-key

# ─── AI Providers ────────────────────────────────────────────────────────────
# At least one provider key is required for real visibility scans.
# The adapter degrades gracefully to "not configured" when keys are absent —
# it never fabricates scan results.
OPENAI_API_KEY=your-openai-api-key
ANTHROPIC_API_KEY=your-anthropic-api-key
PERPLEXITY_API_KEY=your-perplexity-api-key

# ─── Cron ────────────────────────────────────────────────────────────────────
# Required in the x-cron-secret header for the scheduled monitoring endpoint.
# Generate a random 32+ character string.
GEO_CRON_SECRET=generate-a-strong-32+-character-random-string-here

# ─── Stripe (self-serve billing) ─────────────────────────────────────────────
# Required to enable self-serve subscription checkout and billing portal.
# Without these, the settings page falls back to "Contact us" links.
#
# 1. Create a Stripe account at https://stripe.com
# 2. Create monthly recurring prices for each plan
# 3. Set the price IDs below
# 4. Add /api/stripe/webhook as a webhook endpoint in the Stripe dashboard
#    listening for: checkout.session.completed, customer.subscription.*,
#    invoice.payment_failed
#
STRIPE_SECRET_KEY=sk_live_...           # or sk_test_... for development
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_live_...  # or pk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...

# Stripe Price IDs (create in Stripe dashboard → Products → Prices)
STRIPE_PRICE_AI_VISIBILITY=price_...    # $497/mo recurring — AI Visibility plan
STRIPE_PRICE_GROWTH_AGENT=price_...    # $997/mo recurring — Growth Agent plan
# autonomous_growth is sold manually via /book — no price ID needed

# Optional: Override the base URL used in Stripe redirect URLs.
# Defaults to the incoming request origin if not set.
# NEXT_PUBLIC_APP_URL=https://customers.direct

# ─── DataForSEO (SEO intelligence) ───────────────────────────────────────────
# Required for the SEO Intelligence dashboard (keyword rankings, competitor
# gaps, backlink analysis). Without these, the SEO page shows a "not
# configured" state instead of failing.
#
# Sign up at https://dataforseo.com (pay-per-use, ~$0.05–0.25 per full scan)
# SEO data is cached for 7 days per business to minimize API costs.
#
DATAFORSEO_USERNAME=your-dataforseo-login-email
DATAFORSEO_PASSWORD=your-dataforseo-api-password

# ─── Website screenshots (comparison page) ───────────────────────────────────
# Used on the public /compare page to show a screenshot preview above each
# AI Readiness Score. Without this key the page falls back to a branded
# placeholder showing the site's favicon and domain — comparison scores are
# unaffected.
#
# Provider: ScreenshotOne — https://screenshotone.com
#   1. Sign up and copy your Access Key from the dashboard
#   2. Set SCREENSHOTONE_API_KEY below (server-side only — never NEXT_PUBLIC_)
#
# Optional: Set SCREENSHOT_PROVIDER=screenshotone (default, only option currently)
#
SCREENSHOTONE_API_KEY=your-screenshotone-access-key
# SCREENSHOT_PROVIDER=screenshotone
