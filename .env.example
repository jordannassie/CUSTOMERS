# Every variable here is declared in src/lib/env.ts. Required ones fail the build when missing.
# Copy to .env.local for local development. Never commit real values.

# Supabase (required)
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Site URLs (optional). SITE_URL is used for auth redirects; APP_URL overrides Stripe redirect URLs.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_APP_URL=

# AI providers (optional). Scans report "not configured" for a missing key; they never fake results.
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
PERPLEXITY_API_KEY=
OPENAI_NEWS_MODEL=gpt-4o

# Business data (optional)
GOOGLE_PLACES_API_KEY=
# true in dev or Playwright: competitor suggestions come from fixtures, no Google calls
PLACES_FIXTURES=
FIRECRAWL_API_KEY=
BROWSERLESS_API_KEY=

# Search Intelligence (optional, on hold until D-06 is decided)
DATAFORSEO_USERNAME=
DATAFORSEO_PASSWORD=

# Stripe (optional). Use sandbox keys (sk_test_...) outside production.
# Webhook URL: https://customers.direct/api/stripe/webhook
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
# Dev and Playwright only: fake card step, no Stripe calls.
STRIPE_CHECKOUT_FIXTURES=
STRIPE_PRICE_STARTER_MONTHLY=
STRIPE_PRICE_GROWTH_MONTHLY=
STRIPE_PRICE_PRO_MONTHLY=

# Email (optional)
RESEND_API_KEY=
# For example: Customers.Direct <hello@mail.customers.direct> (the domain verified in Resend, src/modules/email/README.md)
EMAIL_FROM=
# At least 32 random characters, e.g. openssl rand -base64 48. Signs unsubscribe links.
EMAIL_UNSUBSCRIBE_SECRET=

# Scan worker (optional). A long random string; pg_net sends it from Supabase Vault (supabase/migrations/README.md).
WORKER_SECRET=
# Seconds the scan worker keeps claiming jobs: 600 on Netlify (default), 240 on Vercel.
WORKER_TIME_BUDGET_SECONDS=
# Where Run scan starts the worker at once, e.g. https://<site>/.netlify/functions/scan-worker-background.
# Unset: the job waits for the every-minute schedule.
WORKER_URL=
# Local dev only: set to true to run the worker inside the dev server when WORKER_URL is unset.
WORKER_IN_PROCESS=

# Admin access (optional). Comma-separated emails; the only source of admin access.
ADMIN_EMAILS=you@example.com
# Alert the admins when real AI cost for the day (UTC) passes this many US dollars. Unset: no cost alert.
ALERT_DAILY_COST_USD=50

# Feature flags: "true" or "false"
BILLING_ENABLED=false
BETA_FREE_ACCESS=true
TRIAL_ENABLED=false
